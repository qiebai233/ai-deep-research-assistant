# =============================================================================
# DeepResearch 配置模板
# =============================================================================
# 用法（在仓库根目录执行其一）：
#   cp .env.example .env              # macOS / Linux / Git Bash
#   Copy-Item .env.example .env       # Windows PowerShell
#
# 只想离线跑通、不申请任何 key？复制即可，什么都别改：
#   默认 llm_provider=mock + search_provider=mock，全流程本地确定性 mock，
#   不联网、无 key，`deepresearch run "你的问题"` 直接生成完整示例报告。
#
# 想接真实模型（最快路径，以 DeepSeek 为例）：
#   1) 复制本文件为 .env
#   2) 填写下面的 DEEPSEEK_API_KEY=<你的 key>
#   3) 运行 `deepresearch providers` 确认 "LLM provider = deepseek / API key = set"
#   （provider 会根据已填写的 key 自动选择，无需手工指定）
#
# 优先级（高 → 低）：命令行参数 > 真实环境变量 > .env 文件 > 内置默认值
# 每个设置字段都可用 DEEPRESEARCH_<字段大写> 设置；
# 常用厂商变量（DEEPSEEK_API_KEY / OPENAI_API_KEY / OPENROUTER_API_KEY /
# TAVILY_API_KEY / SEARXNG_URL 等）会被自动识别为对应别名。
# 完整字段说明见 docs/configuration.md。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. LLM —— 任意 OpenAI 兼容 /chat/completions 接口
#    provider 可选：deepseek | openai | openrouter | ollama | custom | mock
# -----------------------------------------------------------------------------
# 不填则按已填写的 key 自动选择：DEEPSEEK_API_KEY → deepseek，
# OPENAI_API_KEY → openai，OPENROUTER_API_KEY → openrouter；都没有则 mock。
# DEEPRESEARCH_LLM_PROVIDER=deepseek

# 厂商 key 别名（填一个即可；留空表示未配置，不会被读取）
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# 也可使用通用变量（优先级高于厂商别名）
# DEEPRESEARCH_LLM_API_KEY=
# DEEPRESEARCH_LLM_BASE_URL=https://api.deepseek.com/v1
# DEEPRESEARCH_LLM_MODEL=deepseek-chat

# 模型与采样（默认值见右）
# DEEPRESEARCH_LLM_TEMPERATURE=0.3      # 0.0–2.0，越低越稳定
# DEEPRESEARCH_LLM_MAX_TOKENS=0         # 0 = 交给服务端默认值
# DEEPRESEARCH_LLM_TIMEOUT=120          # 单次请求超时（秒）
# DEEPRESEARCH_LLM_MAX_RETRIES=2        # 429/5xx/网络错误重试次数

# 各 provider 预设（llm_base_url / model 会在未显式设置时自动填充）：
#   deepseek    https://api.deepseek.com/v1                     deepseek-chat
#   openai      https://api.openai.com/v1                       gpt-4o-mini
#   openrouter  https://openrouter.ai/api/v1                    openai/gpt-4o-mini
#   ollama      http://localhost:11434/v1                       qwen2.5:7b   （本地，无需 key）
#   custom      （必须显式设置 DEEPRESEARCH_LLM_BASE_URL 与 model）
#   mock        （离线，无需 key、不联网）


# -----------------------------------------------------------------------------
# 2. 联网搜索
#    provider 可选：tavily | searxng | none | mock
# -----------------------------------------------------------------------------
# 不填则自动判断：TAVILY_API_KEY → tavily，SEARXNG_URL → searxng，
# LLM 为 mock 时 → mock，否则 → none（纯模型知识、无外部引用）。
# DEEPRESEARCH_SEARCH_PROVIDER=tavily

# Tavily（https://tavily.com ，注册后在控制台获取 API key；有免费额度）
TAVILY_API_KEY=

# 自建 SearXNG（需在 settings.yml 中开启 json 输出格式），填实例地址
# SEARXNG_URL=http://localhost:8080

# 搜索行为
# DEEPRESEARCH_SEARCH_MAX_RESULTS=6     # 每条 query 返回结果数（1–20）
# DEEPRESEARCH_SEARCH_RECENCY_DAYS=0    # 0 = 不限时间；>0 只取最近 N 天
# DEEPRESEARCH_SEARCH_TIMEOUT=20        # 搜索请求超时（秒）
# DEEPRESEARCH_SEARCH_MAX_RETRIES=1
# DEEPRESEARCH_TAVILY_SEARCH_DEPTH=basic  # basic | advanced（advanced 更慢更贵）


# -----------------------------------------------------------------------------
# 3. 网页抓取与正文提取
# -----------------------------------------------------------------------------
# DEEPRESEARCH_FETCH_TIMEOUT=20         # 单页抓取超时（秒）
# DEEPRESEARCH_FETCH_MAX_CHARS=12000    # 单页正文最多保留字符数
# DEEPRESEARCH_FETCH_CONCURRENCY=4      # 并发抓取数（1–16）
# DEEPRESEARCH_FETCH_MIN_CHARS=300      # 正文少于此值视为抓取质量不足
# DEEPRESEARCH_USER_AGENT=              # 留空使用内置 UA（含项目地址）

# 本地缓存（避免重复抓取同一 URL）
# DEEPRESEARCH_USE_CACHE=true
# DEEPRESEARCH_CACHE_DIR=.deepresearch/cache
# DEEPRESEARCH_CACHE_TTL_HOURS=24


# -----------------------------------------------------------------------------
# 4. 调研行为
# -----------------------------------------------------------------------------
# DEEPRESEARCH_LANGUAGE=zh              # zh | en（也可用 DEEPRESEARCH_LANG）
# DEEPRESEARCH_DEPTH=standard           # quick | standard | deep
# DEEPRESEARCH_OUT_DIR=reports          # 报告输出目录
# DEEPRESEARCH_MAX_SOURCES=0            # 0 = 按 depth 预算（quick 8 / standard 14 / deep 24）
# DEEPRESEARCH_REPORT_JSON=true          # 额外输出 result.json
# DEEPRESEARCH_REPORT_TRACE=true         # 额外输出 trace.jsonl（事件流，便于调试）


# -----------------------------------------------------------------------------
# 5. 预算保护（0 = 不限制；超限时停止后续 LLM 调用并写入报告"局限"）
# -----------------------------------------------------------------------------
# DEEPRESEARCH_MAX_LLM_CALLS=0          # LLM 调用次数上限
# DEEPRESEARCH_MAX_COST_USD=0           # 预估费用上限（美元，按内置价目表估算）
# DEEPRESEARCH_MAX_SECONDS=0            # 整体墙钟时间上限（秒）


# -----------------------------------------------------------------------------
# 6. 日志
# -----------------------------------------------------------------------------
# DEEPRESEARCH_LOG_LEVEL=info           # debug | info | warn | error | quiet
